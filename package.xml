<?xml version="1.0"?>
<package format="3">
  <name>whi_custom_interaction_example</name>
  <version>0.0.1</version>
  <description>WHI Custom Interaction Example for ROS 2</description>

  <maintainer email="sevendull@163.com">Yue Zhou</maintainer>
  <license>Apache-2.0</license>

  <!-- 使用 ROS 2 的构建系统 -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 编译/运行依赖 -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>whi_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav2_msgs</depend>


  <!-- 系统库（如 MQTT、JSON）作为执行依赖 -->
  <exec_depend>jsoncpp</exec_depend>
  <exec_depend>mosquitto</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
